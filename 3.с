#include <stdio.h>

int main(int argc, char *argv[]) {
    if (argc != 2) {
        printf("Usage: %s <filename> \n", argv[0]);
        return 1;
    }

    FILE *file = fopen(argv[1], "w");
    if (!file) {
        perror("Error opening file");
        return 1;
    }

    printf("Enter text (Ctrl+D to exit):\n");
    int ch, count = 0;

    while ((ch = fgetc(stdin)) != EOF && ch != 6){
        fputc(ch, file);
        count++;
    }

    fclose(file);
    printf("Written %d characters to %s\n", count, argv[1]);
    return 0;
}
